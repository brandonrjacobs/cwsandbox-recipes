+    def _spinup_remote(self) -> None:
+        """Use a Gym agent that runs elsewhere; nothing starts in this actor."""
+        global_config = self.cfg.get("initial_global_config_dict") or {}
+        self.rollout_max_attempts_to_avoid_lp_nan = global_config.get(
+            "rollout_max_attempts_to_avoid_lp_nan", 1
+        )
+        assert self.rollout_max_attempts_to_avoid_lp_nan >= 1, (
+            "`rollout_max_attempts_to_avoid_lp_nan` must be at least 1"
+        )
+        self._remote_run_urls = {
+            name: url.rstrip("/") + "/run" for name, url in self.cfg["remote_agent_urls"].items()
+        }
+        self._remote_concurrency = int(global_config.get("remote_concurrency", 256))
+        self._remote_attempts = int(global_config.get("remote_attempts", 3))
+        print(f"Using remote NeMo-Gym agents: {self._remote_run_urls}", flush=True)
+
+    def _run_remote_examples(self, examples: list[dict]):
+        """POST each row to the remote agent's /run; yield awaitables of (row, result)."""
+        import asyncio
+
+        import aiohttp
+
+        semaphore = asyncio.Semaphore(self._remote_concurrency)
+        session = aiohttp.ClientSession(
+            timeout=aiohttp.ClientTimeout(total=None, sock_connect=30, sock_read=3600),
+            connector=aiohttp.TCPConnector(limit=self._remote_concurrency),
+        )
+
+        async def run_one(row: dict) -> tuple[dict, dict]:
+            async with semaphore:
+                for attempt in range(1, self._remote_attempts + 1):
+                    try:
+                        url = self._remote_run_urls[row["agent_ref"]["name"]]
+                        async with session.post(url, json=row) as resp:
+                            if resp.status < 500 or attempt == self._remote_attempts:
+                                if resp.status >= 400:
+                                    body = await resp.text()
+                                    raise RuntimeError(
+                                        f"Gym agent returned HTTP {resp.status}: {body[:2000]}"
+                                    )
+                                return row, await resp.json(content_type=None)
+                    except aiohttp.ClientConnectionError:
+                        if attempt == self._remote_attempts:
+                            raise
+                    await asyncio.sleep(2**attempt)
+                raise AssertionError("unreachable")
+
+        tasks = [asyncio.ensure_future(run_one(row)) for row in examples]
+
+        async def close_when_done() -> None:
+            await asyncio.gather(*tasks, return_exceptions=True)
+            await session.close()
+
+        asyncio.ensure_future(close_when_done())
+        return asyncio.as_completed(tasks)
+
     def shutdown(self) -> None:
